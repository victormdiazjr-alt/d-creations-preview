{{ 'dc-personalized-product.css' | asset_url | stylesheet_tag }}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'DCProductForm-' | append: section.id
%}

<section class="dc-custom-product dc-custom-product--page" data-section-id="{{ section.id }}">
  <div class="dc-custom-product__media">
    {% if product.featured_media %}
      {{ product.featured_media | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480, 720, 960, 1200, 1400', alt: product.title }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'dc-custom-product__placeholder' }}
    {% endif %}
  </div>

  <div class="dc-custom-product__details">
    <p class="dc-custom-product__eyebrow">Personalizado por D Creations</p>
    <h1>{{ product.title | escape }}</h1>
    <div class="dc-custom-product__price">{{ current_variant.price | money }}</div>
    {% if product.description != blank %}<div class="dc-custom-product__description rte">{{ product.description }}</div>{% endif %}

    {% form 'product', product, id: product_form_id, class: 'dc-custom-product__form', enctype: 'multipart/form-data' %}
      {% if product.has_only_default_variant %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% else %}
        <label for="DCVariant-{{ section.id }}">Opción</label>
        <select id="DCVariant-{{ section.id }}" name="id" required>
          {% for variant in product.variants %}
            <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
              {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Agotado{% endunless %}
            </option>
          {% endfor %}
        </select>
      {% endif %}

      <div class="dc-custom-product__fields">
        <div class="dc-field">
          <label for="DCTitle-{{ section.id }}">Título o tema del diseño <span aria-hidden="true">*</span></label>
          <input id="DCTitle-{{ section.id }}" type="text" name="properties[Título o tema]" maxlength="80" required placeholder="Ej. Dinosaurios, fútbol, flores">
        </div>

        <div class="dc-field">
          <label for="DCName-{{ section.id }}">Nombre <span aria-hidden="true">*</span></label>
          <input id="DCName-{{ section.id }}" type="text" name="properties[Nombre]" maxlength="60" required autocomplete="name" placeholder="Nombre que llevará el producto">
        </div>

        <div class="dc-field">
          <label for="DCGrade-{{ section.id }}">Grado o información corta</label>
          <input id="DCGrade-{{ section.id }}" type="text" name="properties[Grado]" maxlength="60" placeholder="Ej. 4to Grado">
        </div>

        <div class="dc-field dc-field--full">
          <label for="DCDescription-{{ section.id }}">Descripción del diseño</label>
          <textarea id="DCDescription-{{ section.id }}" name="properties[Descripción del diseño]" maxlength="500" rows="4" placeholder="Cuéntanos el estilo, colores y elementos que deseas."></textarea>
        </div>

        <div class="dc-field dc-field--full">
          <label for="DCReference-{{ section.id }}">Imagen de referencia{% if section.settings.require_reference %} <span aria-hidden="true">*</span>{% endif %}</label>
          <input id="DCReference-{{ section.id }}" type="file" name="properties[Imagen de referencia]" accept="image/jpeg,image/png,image/webp"{% if section.settings.require_reference %} required{% endif %}>
          <small>JPG, PNG o WEBP. Usa una imagen que tengas derecho a compartir.</small>
        </div>

        <div class="dc-field dc-field--full">
          <label for="DCNotes-{{ section.id }}">Información adicional</label>
          <textarea id="DCNotes-{{ section.id }}" name="properties[Información adicional]" maxlength="500" rows="3" placeholder="Cualquier detalle que debamos considerar."></textarea>
        </div>
      </div>

      <input type="hidden" name="quantity" value="1">
      <button class="dc-custom-product__submit" type="submit"{% unless current_variant.available %} disabled{% endunless %}>
        {% if current_variant.available %}Añadir al carrito{% else %}Agotado{% endif %}
      </button>
    {% endform %}

    <aside class="dc-custom-product__proof">
      <strong>Prueba antes de producir</strong>
      <p>Confirmaremos el arte, el tamaño, el precio y el tiempo de producción antes de fabricar tu pedido personalizado.</p>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Producto personalizado DC",
  "settings": [
    {
      "type": "checkbox",
      "id": "require_reference",
      "label": "Requerir imagen de referencia",
      "default": false
    }
  ],
  "presets": [{"name":"Producto personalizado DC"}]
}
{% endschema %}
